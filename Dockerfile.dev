FROM node:20-slim
WORKDIR /app
ENV HUSKY=0
ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

# Copy everything else; src/ is overridden at runtime by the volume mount in docker-compose.dev.yml
COPY . .

# npm run dev = drizzle-kit push (schema sync) then nodemon
CMD ["npm", "run", "dev"]
